# Common Flatcar Butane config. render.sh substitutes ${...} per node and
# transpiles it to Ignition. Never deploy the files under out/ directly.
#
# Secrets (KEEPALIVED_PASSWORD, SWARM_JOIN_TOKEN) are injected at render time
# from the environment and never committed.
#
# This replaces the old Ansible roles: common (SSH hardening, sudo, reboot),
# docker (docker prune), swarm (init/join, cephfs mount dependency) and
# keepalived.
variant: flatcar
version: 1.1.0

passwd:
  users:
    # Flatcar's core user already has passwordless sudo; the drop-in below
    # makes that explicit. Docker group gives docker access without sudo.
    - name: core
      groups:
        - docker
      ssh_authorized_keys_local:
        - authorized_keys

storage:
  files:
    # Flatcar defaults the hostname to "localhost". Set it explicitly, or every
    # swarm node ends up with the same name.
    - path: /etc/hostname
      overwrite: true
      mode: 0644
      contents:
        inline: ${NODE_NAME}

    # NOTE: must NOT be /etc/sudoers.d/core — Ignition's users section writes
    # that exact path for the core user's sudo grant, and the collision makes
    # Ignition CRITICAL-fail every boot. A distinct drop-in name is identical
    # in effect.
    - path: /etc/sudoers.d/10-core
      overwrite: true
      mode: 0440
      contents:
        inline: |
          core ALL=(ALL) NOPASSWD: ALL

    - path: /etc/ssh/sshd_config.d/10-hardening.conf
      overwrite: true
      mode: 0644
      contents:
        inline: |
          PasswordAuthentication no
          PermitRootLogin no

    # Container resolver: dockerd snapshots its upstreams from the host
    # resolver at start and never re-reads /etc/resolv.conf into running
    # containers, so the networkd pin below does not reach them. Pin the VIP
    # explicitly — the same daemon.json the old Ansible docker role wrote.
    - path: /etc/docker/daemon.json
      overwrite: true
      mode: 0644
      contents:
        inline: |
          {
            "dns": ["10.10.10.20"]
          }

    # Flatcar update/reboot strategy. reboot means locksmithd reboots as soon
    # as an update is ready, but only inside the window below. The window is
    # staggered per node (see nodes/*.env) so the three managers never reboot in
    # the same hour and the swarm keeps quorum. This is the only reboot
    # mechanism: a node with no staged update stays up.
    - path: /etc/flatcar/update.conf
      overwrite: true
      mode: 0420
      contents:
        inline: |
          REBOOT_STRATEGY=reboot
          LOCKSMITHD_REBOOT_WINDOW_START="${REBOOT_WINDOW_START}"
          LOCKSMITHD_REBOOT_WINDOW_LENGTH=1h

    - path: /etc/keepalived/keepalived.conf
      overwrite: true
      mode: 0644
      contents:
        local: keepalived.conf

    # --- keepalived sysext ---------------------------------------------------
    # The keepalived binary comes from the official sysext-bakery, pinned by
    # version AND content (SHA256 1f5ed62072af4993be61a585cd8c3a773a67969142d2
    # b964a38ef20b132a1790 for this v2.3.1 x86-64 image; verify on change).
    # Baked into the config (render.sh copies it into the files dir), so the
    # node needs no network fetch at boot. No systemd-sysupdate config is
    # shipped, so nothing ever updates the extension out of band: it changes
    # only when a new .raw is committed here and nodes are re-rendered.
    - path: /opt/extensions/keepalived/keepalived-v2.3.1-x86-64.raw
      mode: 0644
      contents:
        local: keepalived-v2.3.1-x86-64.raw

    # Host resolver: pin the dns-stack VIP. Flatcar resolves through
    # systemd-resolved, which takes its servers from networkd; DHCP would
    # otherwise add the router's resolver, which cannot resolve
    # *.danhughes.dev. This is the Flatcar replacement for the old Ansible
    # netplan pin (99-dns.yaml with dhcp4-overrides.use-dns: false). The VIP
    # is the keepalived VIP below; both must move together if it ever changes.
    # networkd honours the first lexically-matching unit and ignores later
    # matches, so a full .network unit named 10- wins over the platform's
    # shipped files for this NIC — which is why it must carry the DHCP config
    # itself. Ignition writes it before networkd starts, so no reload is
    # needed. The QEMU pre-flight confirms the lease and the resolver
    # (networkctl status, resolvectl dns).
    - path: /etc/systemd/network/10-cluster.network
      overwrite: true
      mode: 0644
      contents:
        inline: |
          [Match]
          Name=${KEEPALIVED_INTERFACE}

          [Network]
          DHCP=yes
          DNS=10.10.10.20

          [DHCPv4]
          UseDNS=false

    # systemd-sysext merges /opt/extensions into /usr through the /etc/extensions
    # symlink below — this is what makes /usr/bin/keepalived exist.
    # Flatcar ships neither /etc/timezone nor /etc/localtime; two stacks
    # (gitea, homeassistant) ro-bind them from the host, so both must exist
    # with the same zone as the old nodes (Etc/UTC).
    - path: /etc/timezone
      overwrite: true
      mode: 0644
      contents:
        inline: |
          Etc/UTC

  links:
    - path: /etc/extensions/keepalived.raw
      target: /opt/extensions/keepalived/keepalived-v2.3.1-x86-64.raw
      hard: false
    - path: /etc/localtime
      target: /usr/share/zoneinfo/Etc/UTC
      hard: false

systemd:
  units:
    # Gate network-online.target on the real DHCP lease. Without this the
    # target is reached before any interface has an address and mnt-nas.mount
    # races the network (lost on real hardware: "Network is unreachable" at
    # boot+0s; QEMU's instant link never exposed it).
    - name: systemd-networkd-wait-online.service
      enabled: true

    # --- TrueNAS config export ---------------------------------------------
    - name: mnt-nas.mount
      enabled: true
      contents: |
        [Unit]
        Description=TrueNAS config export at /mnt/nas
        After=network-online.target
        Wants=network-online.target

        [Mount]
        What=${NAS_SERVER}:${NAS_EXPORT}
        Where=/mnt/nas
        Type=nfs
        Options=nfsvers=4.0,_netdev,rw,noatime,hard,rsize=1048576,wsize=1048576

        [Install]
        WantedBy=multi-user.target

    - name: rpc-statd.service
      enabled: true

    # Docker must not start until the config export is mounted. Replaces the
    # old /usr/lib/systemd/system/docker.service.d/after-mount.conf.
    - name: docker.service
      dropins:
        - name: 10-nas.conf
          contents: |
            [Unit]
            Requires=mnt-nas.mount
            After=mnt-nas.mount

    # --- Weekly Docker prune ------------------------------------------------
    - name: docker-prune.service
      contents: |
        [Unit]
        Description=Docker system prune with volumes

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/docker system prune --volumes -f

    - name: docker-prune.timer
      enabled: true
      contents: |
        [Unit]
        Description=Run Docker prune weekly

        [Timer]
        OnCalendar=Sun *-*-* 03:00:00
        RandomizedDelaySec=1h
        Persistent=true

        [Install]
        WantedBy=timers.target

    # --- Swarm membership ---------------------------------------------------
    # One unit name, two bodies: render.sh picks swarm-init.service for cl01
    # and swarm-join.service for the followers via ${SWARM_UNIT_FILE}.
    - name: swarm.service
      enabled: true
      contents_local: ${SWARM_UNIT_FILE}

    # --- keepalived ---------------------------------------------------------
    # Runs from the sysext above. All three nodes start BACKUP@50 during the
    # migration (below the old nodes: leader 100, followers 90) so Flatcar only
    # takes the VIP if an old MASTER dies — never by preemption. After the last
    # swap, restore cl01 to MASTER@100 (nodes/cl01.env KEEPALIVED_STATE/
    # KEEPALIVED_PRIORITY, re-render). Values come from nodes/*.env and must
    # match the live cluster election (instance, id 51, PASS auth, VIP).
    - name: keepalived.service
      enabled: true
      contents: |
        [Unit]
        Description=Keepalived
        After=network-online.target
        Wants=network-online.target

        [Service]
        ExecStart=/usr/bin/keepalived --dont-fork --log-console
        Restart=on-failure

        [Install]
        WantedBy=multi-user.target
      dropins:
        - name: zz-override.conf
          contents: |
            # The keepalived sysext ships 10-keepalived.conf which replaces
            # ExecStart with a daemonizing command (no --dont-fork). Under our
            # Type=simple unit the parent then exits, systemd kills the
            # cgroup, and the service restart-loops. Re-assert the foreground
            # form; keepalived's default config path already is
            # /etc/keepalived/keepalived.conf.
            [Service]
            ExecStartPre=
            ExecStart=
            ExecStart=/usr/bin/keepalived --dont-fork --log-console
