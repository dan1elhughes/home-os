[Unit]
Description=Release UPS-caused swarm drain at boot
# Boot ordering: un-drain needs docker. The undrain waits (inside the
# command) for the UPS to report OL, so it may run for hours after a
# dead-battery drain: TimeoutStartSec=0 disables the oneshot limit.
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=UPS_LOG=/var/log/ups-watcher.log
EnvironmentFile=/etc/ups-watcher/creds
ExecStart=/opt/bin/ups-watcher undrain
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
