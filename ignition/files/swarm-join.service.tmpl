[Unit]
Description=Join Docker Swarm as manager
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=!/var/lib/docker/swarm/state.json

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker swarm join --token ${SWARM_JOIN_TOKEN} ${MANAGER_IP}:2377

[Install]
WantedBy=multi-user.target
