# Per-node values for cl03 (Phase 4 manager, joined with the baked token).
NODE_NAME=cl03
NODE_IP=10.10.10.23
SWARM_UNIT_FILE=swarm-join.service
MANAGER_IP=10.10.10.21
NAS_SERVER=10.10.10.60
NAS_EXPORT=/mnt/SSD/cluster
# BACKUP@50: below the old nodes (leader 100, followers 90) during the
# migration; see cl01.env.
KEEPALIVED_STATE=BACKUP
KEEPALIVED_PRIORITY=50
KEEPALIVED_INTERFACE=enp1s0
# Staggered Flatcar update-reboot window (one hour after cl02).
REBOOT_WINDOW_START="Sun 04:00"
