# Per-node values for cl02 (Phase 4 manager, joined with the baked token).
NODE_NAME=cl02
NODE_IP=10.10.10.22
SWARM_UNIT_FILE=swarm-join.service
MANAGER_IP=10.10.10.21
NAS_SERVER=10.10.10.60
NAS_EXPORT=/mnt/SSD/local/cluster
# BACKUP@50: below the old nodes (leader 100, followers 90) during the
# migration; see cl01.env.
KEEPALIVED_STATE=BACKUP
KEEPALIVED_PRIORITY=50
KEEPALIVED_INTERFACE=enp1s0
# Staggered Flatcar update-reboot window (one hour after cl01).
REBOOT_WINDOW_START="Sun 03:00"

# UPS role: peers drain their swarm tasks and power off on confirmed OB.
UPS_ROLE=peer

# pi-nut upsd LAN address (not a secret); an exported 1Password value wins.
UPS_NUT_HOST=10.10.10.12:3493
