# Per-node values for cl01 (the first Flatcar node, Phase 1 manager).
# No secrets here: KEEPALIVED_PASSWORD and SWARM_JOIN_TOKEN come from the
# environment at render time.
NODE_NAME=cl01
NODE_IP=10.10.10.21
SWARM_UNIT_FILE=swarm-init.service
MANAGER_IP=10.10.10.21
NAS_SERVER=10.10.10.60
NAS_EXPORT=/mnt/SSD/cluster
KEEPALIVED_STATE=MASTER
KEEPALIVED_PRIORITY=100
# LAN interface from the existing nodes (`ip -br link`): enp1s0. Flatcar uses
# the same predictable naming, but confirm it on the booted node before Phase 3.
KEEPALIVED_INTERFACE=enp1s0
# Staggered Flatcar update-reboot window. cl01 owns the first hour so the
# three managers never reboot together (locksmithd only reboots for updates).
REBOOT_WINDOW_START="Sun 02:00"
