# Per-node values for cl01 (the first node swapped, Phase 3).
# No secrets here: KEEPALIVED_PASSWORD and SWARM_JOIN_TOKEN come from the
# environment at render time.
NODE_NAME=cl01
NODE_IP=10.10.10.21
# All three nodes JOIN the live swarm — the swarm is never re-initialised
# (runbook decision 13). A swarm init here would fork a second cluster while
# cl02/cl03 still hold the real one.
SWARM_UNIT_FILE=swarm-join.service
# Join target: a manager that is alive while cl01 is being swapped. cl02 is
# still on the old OS at that point, so it holds quorum. Re-check at render
# time (Phase 3 re-renders every node before its swap).
MANAGER_IP=10.10.10.22
NAS_SERVER=10.10.10.60
NAS_EXPORT=/mnt/SSD/cluster
# BACKUP@50 during the migration: below every old node (leader 100, followers
# 90) so Flatcar only takes the VIP if an old MASTER dies, never by
# preemption. After the final swap, bump cl01 to MASTER@100 (edit
# /etc/keepalived/keepalived.conf or re-render).
KEEPALIVED_STATE=BACKUP
KEEPALIVED_PRIORITY=50
# LAN interface from the existing nodes (`ip -br link`): enp1s0. Flatcar uses
# the same predictable naming, but confirm it on the booted node before Phase 3.
KEEPALIVED_INTERFACE=enp1s0
# Staggered Flatcar update-reboot window. cl01 owns the first hour so the
# three managers never reboot together (locksmithd only reboots for updates).
REBOOT_WINDOW_START="Sun 02:00"
