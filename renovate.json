{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "assignees": ["dan1elhughes"],
  "prHourlyLimit": 0,
  "pruneStaleBranches": true,
  "recreateWhen": "always",
  "dependencyDashboard": true,
  "fetchChangeLogs": "off",
  // Renovate merges its own PRs instead of handing them to GitHub's
  // auto-merge, so a merge waits for the next run and the `validate` check.
  "platformAutomerge": false,
  "toolSettings": {
    "nodeMaxMemory": 4096
  },
  // Lidarr Docker tags include a legacy `0.8.1.2135` tag.
  // Renovate misinterprets this as `8.1.2135`, which appears newer than v3.x.
  // This explicitly blocks that tag to prevent incorrect upgrade PRs.
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/linuxserver/lidarr"],
      "allowedVersions": "!/^8\\.1\\.2135$/"
    },
    // PostgreSQL major versions break the data directory. Pin to 18.x.
    {
      "matchPackageNames": ["postgres"],
      "allowedVersions": "/^18/"
    },
    // predbat_addon publishes variant-prefixed tags (e.g. `slim-v8.42.1`,
    // `alpine-v8.42.1`, `v8.42.1`). Pin Renovate to the `slim-v` track and
    // teach it to parse the semver that follows the prefix.
    {
      "matchPackageNames": ["nipar44/predbat_addon"],
      "versioning": "regex:^slim-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    // Ombi's Jellyfin 12 authentication fix is only in the development line
    // (4.60.x) so far. Pin Renovate to the `X.Y.Z-development` track; drop this
    // rule and return to a stable tag once a release carries the fix.
    {
      "matchPackageNames": ["ghcr.io/linuxserver/ombi"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-development$"
    },
    // Patch and digest updates merge on their own once `validate` passes.
    // Minor and major stay manual: a merge here deploys to the live swarm.
    {
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    },
    // Renovate cuts several releases a day, and each one redeploys this stack
    // and sends a deploy notification. Take the latest once a week instead.
    {
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "schedule": ["before 6am on monday"]
    }
  ]
}
